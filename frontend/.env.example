# All optional. Copy to .env if you need to change them.

# Where the API lives.
#  - unset in dev  -> "/api" (proxied by Vite to VITE_PROXY_TARGET, cookies work)
#  - unset in prod -> https://snitch-beka.onrender.com/api
# VITE_API_URL=

# Backend that the Vite dev server proxies "/api" to (dev only).
# VITE_PROXY_TARGET=http://localhost:5000

# Set to "true" ONLY if the backend is configured for credentialed CORS
# (cors({ origin: <frontend url>, credentials: true }) and cookie sameSite:"none", secure:true).
# VITE_WITH_CREDENTIALS=false
